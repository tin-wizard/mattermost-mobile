## You invoke this with --env ios.beta on the fastlane command
APP_NAME="TIN Connect"
APP_SCHEME=mattermost
BETA_BUILD=true
BUILD_FOR_RELEASE=true
EXTENSION_APP_IDENTIFIER=io.tin.mobile.MattermostShare
FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT=120
FASTLANE_XCODEBUILD_SETTINGS_RETRIES=6
IOS_APP_GROUP=group.io.tin.mobile
IOS_BUILD_EXPORT_METHOD=app-store
IOS_ICLOUD_CONTAINER=iCloud.io.tin.mobile
MAIN_APP_IDENTIFIER=io.tin.mobile
MATCH_APP_IDENTIFIER=io.tin.mobile.NotificationService,io.tin.mobile.MattermostShare,io.tin.mobile
MATCH_READONLY=true
MATCH_SHALLOW_CLONE=true
MATCH_SKIP_DOCS=true
MATCH_TYPE=appstore
NOTIFICATION_SERVICE_IDENTIFIER=io.tin.mobile.NotificationService
REPLACE_ASSETS=false
SENTRY_ENABLED=false
SYNC_PROVISIONING_PROFILES=true

INTUNE_ENABLED=false
